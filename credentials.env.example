# ==============================================================================
# credentials.env.example - every credential the harness needs, in one place
#
#   cp credentials.env.example ~/.snowcommander-creds.env
#   chmod 600 ~/.snowcommander-creds.env
#   vi ~/.snowcommander-creds.env
#
#   set -a; source ~/.snowcommander-creds.env; set +a
#
# Encrypt at rest (ansible-vault):
#   ./scripts/creds-vault.sh init
#   ./scripts/creds-vault.sh encrypt
#   ./scripts/creds-vault.sh status
# target.sh and e2e auto-decrypt ~/.snowcommander-creds.env.vault using
# ~/.snowcommander-vault.pass (or SNOWCOMMANDER_VAULT_PASS_FILE).
#
# Keep the real file OUTSIDE this repository (your home directory is fine).
# .gitignore blocks *.env here as a backstop, but do not rely on that.
#
# Nothing below is ever passed as a command-line argument: arguments are
# visible to any user who can run `ps`, environment variables are not.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. vSphere - used by stages 1-3 to clone the template
#
# Scope: the tooling refuses to touch anything outside SnowCommander/Templates.
# A read-only account with Clone and Power On rights on that folder only is
# sufficient, and is what you should use.
# ------------------------------------------------------------------------------
VCENTER_USER=your.name@strykercorp.com
VCENTER_PASSWORD=REPLACE_ME

# vCenters holding the SnowCommander/Templates folder:
#   blr-vsphere-01.strykercorp.com
#   fw-vsphere-01.strykercorp.com
#   stc-vsphere-01.strykercorp.com  (templates: SC-Redhat 9, portgroup: stc-vlan847)

# ------------------------------------------------------------------------------
# 2. Target VM login - used by stages 4-8 over SSH
#
# Prefer a key. Use SSHPASS only for freshly cloned templates that have not yet
# had a key installed.
# ------------------------------------------------------------------------------
TARGET_SSH_USER=tpx-admin
# TARGET_SSH_KEY=/home/tpx-admin/.ssh/id_ed25519
SSHPASS=REPLACE_ME

# ------------------------------------------------------------------------------
# 3. Security tool configuration - used by stage 5
#
# FALCON_PROVISIONING_TOKEN is optional: some tenants require it for sensor install.
# security.sh only passes --provisioning-token when the variable is set.
# ------------------------------------------------------------------------------
FALCON_CID=D204F3B9227D492DA43F7AF999501417-FF
# FALCON_PROVISIONING_TOKEN=

CMDBSYNC_PASSWORD=REPLACE_ME
CMDBSYNC_UID=2800
CMDBSYNC_GID=1700

AZCM_SP_CLIENT_ID=REPLACE_ME
AZCM_SP_SECRET=REPLACE_ME
AZCM_SUBSCRIPTION_ID=REPLACE_ME
AZCM_TENANT_ID=REPLACE_ME
AZCM_RESOURCE_GROUP=RSG-Sentinel-Azure-Arc
AZCM_LOCATION=eastus2
AZCM_CLOUD=AzureCloud
AZCM_TAGS=Environment=Test

SYSLOG_SERVER1=10.132.118.100
SYSLOG_SERVER2=10.50.118.100
SYSLOG_PORT=514

# ------------------------------------------------------------------------------
# 4. Red Hat Subscription Manager - needed to install rsyslog from Red Hat repos
#
# Who keeps a subscription:
#   BLR-Redhat-9, BLR-Redhat-10, SC-Redhat 9   registration is KEPT
#   BLR-GI-*, BLR-GI-Engage-*                  registered to install, then UNREGISTERED
#
# --rhsm-mode auto (the default) applies that rule from the template name.
# Override with --rhsm-mode keep|remove|skip.
# ------------------------------------------------------------------------------
RHSM_USERNAME=REPLACE_ME
RHSM_PASSWORD=REPLACE_ME
