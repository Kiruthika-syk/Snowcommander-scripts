# Copy to securitytools.env in this directory, fill EVERY value (including secrets), chmod 600.
# target.sh sources this file; e2e writes the tool variables onto each template (mode 600).

# --- Jump host / vSphere / SSH (used by target.sh, not copied to templates) ---
VCENTER_USER=REPLACE_ME
VCENTER_PASSWORD=REPLACE_ME
SSHPASS=REPLACE_ME

RHSM_USERNAME=REPLACE_ME
RHSM_PASSWORD=REPLACE_ME

FALCON_CID=D204F3B9227D492DA43F7AF999501417-FF
# FALCON_PROVISIONING_TOKEN is intentionally absent: this tenant does not
# require one. security.sh only passes --provisioning-token when it is set.

CMDBSYNC_UID=2800
CMDBSYNC_GID=1700
CMDBSYNC_PASSWORD=REPLACE_ME

SYSLOG_SERVER1=10.132.118.100
SYSLOG_SERVER2=10.50.118.100
SYSLOG_PORT=514

