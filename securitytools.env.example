# Copy to securitytools.env, fill secrets, and set mode 600.

RHSM_USERNAME=REPLACE_ME
RHSM_PASSWORD=REPLACE_ME

FALCON_CID=D204F3B9227D492DA43F7AF999501417-FF
# FALCON_PROVISIONING_TOKEN is intentionally absent: this tenant does not
# require one. security.sh only passes --provisioning-token when it is set.

CMDBSYNC_UID=2800
CMDBSYNC_GID=1700
CMDBSYNC_PASSWORD=REPLACE_ME

SYSLOG_SERVER1=10.132.118.100
SYSLOG_SERVER2=10.50.118.100
SYSLOG_PORT=514

AZCM_SP_CLIENT_ID=REPLACE_ME
AZCM_SP_SECRET=REPLACE_ME
AZCM_SUBSCRIPTION_ID=REPLACE_ME
AZCM_RESOURCE_GROUP=RSG-Sentinel-Azure-Arc
AZCM_TENANT_ID=REPLACE_ME
AZCM_LOCATION=eastus2
AZCM_CLOUD=AzureCloud
# Portal LinuxOnBoardingScript (Sep 2026) tag format — quote the whole value in real env files
AZCM_TAGS="'Cost Center'=1392,'Resource Owner'=parthav.reddy1@stryker.com"
AZCM_CORRELATION_ID=
AZCM_DISCONNECT_BEFORE_CONNECT=0
# AZCM_RESOURCE_NAME=          # optional; omit to use portal default Arc machine name
# AZCM_AUTO_RESOURCE_NAME=1      # hostname-MAC suffix when resource name collisions occur
